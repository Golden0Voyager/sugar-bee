# Sugar Bee 配置示例 —— 部署到新机器时复制为 .env 后逐项填写。
# 真实值不要提交到 Git（.env 已被 .gitignore 排除）。

# ---------- 应用核心 ----------
# Flask session 签名密钥，必填。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---------- Garmin 同步 ----------
# 首次获取 token：本机执行 python garmin_login.py，产物 .garmin_tokens/garmin_tokens.json
# 迁移到新机器时直接 scp 该目录即可，无需重新登录。
# GARMIN_USER_ID 为字符串形式的用户号（见 Garmin 个人资料页），留空则用邮箱。
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_USER_ID=
# 后台自动同步间隔（秒），默认 3600
GARMIN_SYNC_INTERVAL=3600

# ---------- 性能 / 部署 ----------
# SQLite 不支持并发写入。个人使用建议 2；内存紧张或写入冲突频繁可降到 1。
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
# 对外端口，宿主 nginx 反代的 upstream
SUGAR_BEE_PORT=5000
# 无 HTTPS / IP 直连时为 false，接入 HTTPS 后删掉或改 true
SESSION_COOKIE_SECURE=false
# 会话闲置多久需要重新登录（小时），默认 720 = 30 天。家人嫌重登烦就保持默认
SESSION_LIFETIME_HOURS=720
# 业务时区，影响“今天”的界定与 reports 的日期
TZ=Asia/Shanghai

# ---------- 大模型 / AI 相关 ----------
# 按需填写，未填对应功能会自动降级或跳过
MODELSCOPE_API_KEY=
VOLC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# 供 iOS 快捷指令 / MCP 侧调用的内部令牌，留空时 /internal/* 返回 503（默认安全）
AGENT_API_TOKEN=

# 常见遗漏：FLASK_DEBUG 本项目未使用，不要设置（生产环境务必关闭）。
